# .env nomi bilan nusxa qiling va qiymatlarni o'zgartiring.
PORT=3000

# Kamida 32 belgili tasodifiy satr. Masalan: openssl rand -hex 32
AUTH_SECRET=

# Foydalanuvchilar: login:parol,login2:parol2  (parol kamida 10 belgi)
AUTH_USERS=

# Excel fayl yo'li (public/ ichida BO'LMASLIGI kerak)
DATA_FILE=./data/data.xlsx

# Token amal qilish muddati (soat)
TOKEN_TTL_HOURS=8

# Nginx/Cloudflare orqasida ishlasa 1 qiling (to'g'ri IP uchun)
TRUST_PROXY=0
