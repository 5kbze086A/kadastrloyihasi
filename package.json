  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file=.env --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
